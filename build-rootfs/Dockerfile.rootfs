# build-rootfs/Dockerfile.rootfs

# ── Stage 1: cross-compile podroid-vsock-agent (static aarch64) ──────────
# Uses qemu-user under the hood — no separate cross-toolchain needed.
FROM --platform=linux/arm64 debian:bookworm AS vsock-builder
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc make libc6-dev linux-libc-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /work
COPY vsock-agent /work/vsock-agent
RUN cd /work/vsock-agent && make CC=gcc
COPY host-bridge /work/host-bridge
RUN cd /work/host-bridge && make CC=gcc
COPY overlay-normalize /work/overlay-normalize
RUN cd /work/overlay-normalize && make CC=gcc

# ── Stage 2: build the Debian rootfs squashfs ─────────────────────────────
FROM debian:bookworm AS builder

ARG DEBIAN_ARCH=arm64
ARG SYSTEM_VERSION=0

ENV DEBIAN_FRONTEND=noninteractive
ENV SYSTEM_VERSION=${SYSTEM_VERSION}

RUN apt-get update && apt-get install -y --no-install-recommends \
    debootstrap \
    squashfs-tools \
    openssl \
    libcap2-bin \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work

# Bootstrap a minimal Debian bookworm rootfs for the target arch.
# --variant=minbase: smallest functional root (no docs, no manpages).
# --include: packages needed at first boot, installed during debootstrap
#   so the rootfs is usable before the overlay is applied.
RUN debootstrap --arch=${DEBIAN_ARCH} --variant=minbase \
    --include=systemd,systemd-sysv,dbus, \
    bash,coreutils,util-linux,iproute2,iputils-ping, \
    openssh-server,openssh-client,curl,ca-certificates, \
    podman,docker.io,containerd, \
    iptables,nftables,bridge-utils, \
    crun,uidmap,fuse-overlayfs,slirp4netns, \
    aardvark-dns,netavark, \
    sudo,less,vim-tiny,gzip,xz-utils, \
    tigervnc-standalone-server,tigervnc-common, \
    pulseaudio,pulseaudio-utils, \
    fonts-dejavu-core,fonts-misc-fixed, \
    kmod,e2fsprogs, \
    bookworm rootfs \
    http://deb.debian.org/debian

# Pull in the vsock-agent binary built in stage 1.
COPY --from=vsock-builder /work/vsock-agent/podroid-vsock-agent /work/rootfs/usr/local/bin/podroid-vsock-agent
COPY --from=vsock-builder /work/host-bridge/podroid-hostd /work/rootfs/usr/local/bin/podroid-hostd
COPY --from=vsock-builder /work/overlay-normalize/podroid-overlay-normalize /work/rootfs/usr/local/bin/podroid-overlay-normalize

COPY files /work/files
# Staged by build_rootfs() in build-all.sh (docs/ lives outside this build
# context); served in-guest by /usr/local/bin/podroid-docs.
COPY docs-guide /work/docs-guide
COPY build-rootfs.sh /work/build-rootfs.sh
RUN chmod +x /work/build-rootfs.sh && /work/build-rootfs.sh

RUN mksquashfs /work/rootfs /work/debian-rootfs.squashfs \
    -comp zstd -Xcompression-level 19 -all-root -noappend
# (No -no-xattrs: rootless podman's newuidmap/newgidmap need their
# file capabilities preserved; they're stored as security.capability xattr.)

FROM scratch AS export
COPY --from=builder /work/debian-rootfs.squashfs /debian-rootfs.squashfs
