#!/bin/sh
# Podroid X11 server manager (Xvnc + pulseaudio) for the in-app viewer.
# Invoked by podroid-x11.service (systemd) with "start" or "stop" argument.
set -eu

XVNC_DISPLAY=:0
XVNC_GEOMETRY=1280x720
XVNC_PORT=5900
PA_PORT=4713
PA_RUNTIME=/run/podroid-pulse
PA_LOGFILE=/var/log/pulse.log
XVNC_LOGFILE=/var/log/xvnc.log

cmd_start() {
    XVNC_DPI=$(sed -n 's/.*podroid\.x11\.dpi=\([0-9]*\).*/\1/p' /proc/cmdline 2>/dev/null)
    [ -z "$XVNC_DPI" ] && XVNC_DPI=96

    rm -f /tmp/.X0-lock /tmp/.X11-unix/X0

    mkdir -p "$PA_RUNTIME"
    chmod 755 "$PA_RUNTIME"

    # Xvnc: combined X server + RFB.
    /usr/bin/Xvnc \
        $XVNC_DISPLAY \
        -geometry $XVNC_GEOMETRY \
        -depth 24 \
        -SecurityTypes None \
        -localhost no \
        -rfbport $XVNC_PORT \
        -AlwaysShared \
        -dpi $XVNC_DPI \
        -AcceptSetDesktopSize \
        >"$XVNC_LOGFILE" 2>&1 &
    _xvnc_pid=$!
    _i=0
    while [ "$_i" -lt 10 ]; do
        sleep 0.1
        kill -0 "$_xvnc_pid" 2>/dev/null && break
        _i=$((_i + 1))
    done
    if ! kill -0 "$_xvnc_pid" 2>/dev/null; then
        echo "WARN: Xvnc failed to start (see $XVNC_LOGFILE)" > /dev/console
        _xvnc_rc=1
    else
        echo "$_xvnc_pid" > /run/xvnc.pid
        _xvnc_rc=0
    fi

    # PulseAudio: system-wide-style daemon writing raw S16LE PCM to TCP 4713.
    PULSE_RUNTIME_PATH="$PA_RUNTIME" \
    XDG_RUNTIME_DIR="$PA_RUNTIME" \
    /usr/bin/pulseaudio \
        --daemonize=no \
        --disallow-exit \
        --exit-idle-time=-1 \
        --load="module-null-sink sink_name=podroid_sink rate=44100 channels=2 format=s16le" \
        --load="module-simple-protocol-tcp source=podroid_sink.monitor record=true rate=44100 format=s16le channels=2 listen=0.0.0.0 port=$PA_PORT" \
        --load="module-native-protocol-unix" \
        >"$PA_LOGFILE" 2>&1 &
    _pa_pid=$!
    _i=0
    while [ "$_i" -lt 10 ]; do
        sleep 0.1
        kill -0 "$_pa_pid" 2>/dev/null && break
        _i=$((_i + 1))
    done
    if ! kill -0 "$_pa_pid" 2>/dev/null; then
        echo "WARN: pulseaudio failed to start (see $PA_LOGFILE)" > /dev/console
        _pa_rc=1
    else
        echo "$_pa_pid" > /run/pulseaudio.pid
        _pa_rc=0
    fi

    [ "$_xvnc_rc" -eq 0 ] && [ "$_pa_rc" -eq 0 ]
}

cmd_stop() {
    if [ -f /run/xvnc.pid ]; then
        kill "$(cat /run/xvnc.pid)" 2>/dev/null || true
        rm -f /run/xvnc.pid
    fi
    if [ -f /run/pulseaudio.pid ]; then
        kill "$(cat /run/pulseaudio.pid)" 2>/dev/null || true
        rm -f /run/pulseaudio.pid
    fi
}

case "${1:-start}" in
    start) cmd_start ;;
    stop)  cmd_stop ;;
    *) echo "usage: $0 {start|stop}" >&2; exit 1 ;;
esac
exit $?
