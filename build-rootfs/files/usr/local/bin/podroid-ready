#!/bin/sh
# Podroid VM ready marker — emits boot stages for the Android boot detector.
# Invoked by podroid-ready.service (systemd).
set -eu

# OOM-protect Podroid's infrastructure processes so a hungry user app
# gets reaped first. -1000 makes a process completely immune to OOM.
for _name in dropbear sshd Xvnc pulseaudio podroid-vsock-agent dnsmasq; do
    for _pid in $(pgrep -x "$_name" 2>/dev/null); do
        echo -1000 > "/proc/$_pid/oom_score_adj" 2>/dev/null
    done
done

# Emit the boot stages BootStageDetector expects.
echo "Starting SSH..." > /dev/console
echo "Almost ready..." > /dev/console
echo "Ready!" > /dev/console
exit 0
